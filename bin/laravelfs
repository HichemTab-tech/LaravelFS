#!/usr/bin/env php
<?php

if (file_exists(__DIR__.'/../../../autoload.php')) {
    /** @noinspection PhpIncludeInspection */
    require __DIR__.'/../../../autoload.php';
} else {
    require __DIR__.'/../vendor/autoload.php';
}

// Define our own version and the Laravel Installer version we aim to match.
$laravelFSVersion = '1.3.0';
$laravelInstallerVersion = '5.24.7';

// Compose the displayed version string.
$displayVersion = sprintf('%s (advanced from Laravel Installer %s)', $laravelFSVersion, $laravelInstallerVersion);

$app = new Symfony\Component\Console\Application('LaravelFS Installer', $displayVersion);

$method = method_exists($app, 'addCommand') ? 'addCommand' : 'add';

$app->$method(new HichemTabTech\LaravelFS\Console\NewCommand);
$app->$method(new HichemTabTech\LaravelFS\Console\NewTemplateCommand);
$app->$method(new HichemTabTech\LaravelFS\Console\ShowTemplatesCommand);
$app->$method(new HichemTabTech\LaravelFS\Console\UseTemplateCommand);
$app->$method(new HichemTabTech\LaravelFS\Console\RemoveTemplateCommand);

/** @noinspection PhpUnhandledExceptionInspection */
$app->run();
